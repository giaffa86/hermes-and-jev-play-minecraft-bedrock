{
  "name": "hermes-and-jev-play-minecraft",
  "version": "0.1.0",
  "description": "Hermes Agent plans, Jev (TypeSafe) picks bounded actions, a Bedrock-compatible harness executes them \u2014 Minecraft Bedrock Edition with no screenshots and no keypresses from a model.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "harness": "node harness.mjs",
    "bedrock-harness": "node bedrock-harness.mjs",
    "play": "node controller.mjs",
    "test": "node --test tests/*.test.mjs",
    "test-ping": "node test-ping.mjs",
    "test-reconnect": "node --env-file=.env test-reconnect.mjs",
    "test-world": "node tests/bedrock-world.test.mjs"
  },
  "dependencies": {
    "bedrock-protocol": "^3.60.1",
    "flying-squid": "^1.12.0",
    "jsp-raknet": "^2.2.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "nethernet": "^1.1.2",
    "prismarine-auth": "^3.1.1",
    "prismarine-chunk": "^1.41.0",
    "prismarine-world": "^3.7.0",
    "vec3": "^0.2.0",
    "prismarine-registry": "^1.12.0",
    "prismarine-block": "^1.23.0"
  }
}
