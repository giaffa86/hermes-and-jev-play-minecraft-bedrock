# --- Connessione al server Bedrock ---
BEDROCK_HOST=<ip-server-bedrock>
BEDROCK_PORT=19132

# Account Microsoft/Xbox del bot (gamertag o email).
# Il gamertag deve essere presente in <percorso-server>/allowlist.json del server Bedrock.
BEDROCK_USERNAME=

# Directory dove prismarine-auth cachea i token Xbox (default: ~/.minecraft/nmp-cache).
BEDROCK_PROFILES_DIR=

# (Opzionale) Titolo di autenticazione. Default: MinecraftNintendoSwitch.
# BDS controlla che DeviceOS corrisponda alla piattaforma usata per autenticare.
# Alternative valide: MinecraftAndroid, MinecraftIOS, MinecraftPlaystation, MinecraftNintendoSwitch.
BEDROCK_AUTH_TITLE=MinecraftNintendoSwitch

# --- Controller Jev ---
# Scegli UNA delle due chiavi. Se imposti TYPESAFE_API_KEY, il controller
# chiama direttamente https://api.typesafe.ai/v1/systemone.
# Se imposti OPENROUTER_API_KEY, usa l'endpoint decisions di OpenRouter.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Modello Jev. Per TypeSafe usa "jev-latest"; per OpenRouter "typesafe/jev-1.13".
JEV_MODEL=jev-latest

# --- Goal del planner (opzionali) ---
GOAL="Hold at least 4 dirt in inventory and stand within 2 blocks of the waypoint."
WAYPOINT='{"x":380,"z":16}'
TARGETS='{"dirt":4}'
MAX_STEPS=20
REPLAN_EVERY=8
CONTROLLER=jev
RUN_ID=demo
HARNESS=http://127.0.0.1:3077

# --- Survival Intelligence Layer (opzionali) ---
# Milestone finale gestito dal Progression Engine: il controller sceglie da solo
# i prerequisiti mancanti (knowledge/progression.json) e verifica lo stato reale
# (runs/<run>/skills.jsonl). Esempi: first_night, enter_nether.
# Con CURRICULUM impostato, WAYPOINT e TARGETS possono restare vuoti.
# CURRICULUM=first_night

# Obiettivo suggerito in /survival (solo diagnostica del harness, opzionale).
# PROGRESSION_GOAL=enter_nether
