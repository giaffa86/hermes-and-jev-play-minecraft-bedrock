# --- Connessione al server Bedrock ---
BEDROCK_HOST=<ip-server-bedrock>
BEDROCK_PORT=19132

# Account Microsoft/Xbox del bot (gamertag o email).
# Il gamertag deve essere presente nell'allowlist del server Bedrock.
BEDROCK_USERNAME=

# Directory dove prismarine-auth cachea i token Xbox (default: ~/.minecraft/nmp-cache).
BEDROCK_PROFILES_DIR=

# (Opzionale) Titolo di autenticazione. Default: MinecraftNintendoSwitch.
# BDS controlla che DeviceOS corrisponda alla piattaforma usata per autenticare.
# Alternative valide: MinecraftAndroid, MinecraftIOS, MinecraftPlaystation, MinecraftNintendoSwitch.
BEDROCK_AUTH_TITLE=MinecraftNintendoSwitch

# --- Controller Jev ---
# Scegli UNA delle due chiavi. Se imposti TYPESAFE_API_KEY, il controller
# chiama direttamente https://api.typesafe.ai/v1/systemone.
# Se imposti OPENROUTER_API_KEY, usa l'endpoint decisions di OpenRouter.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# Modello Jev. Per TypeSafe usa "jev-latest"; per OpenRouter "typesafe/jev-1.13".
JEV_MODEL=jev-latest

# --- Goal del planner (opzionali) ---
GOAL="Hold at least 4 dirt in inventory and stand within 2 blocks of the waypoint."
WAYPOINT='{"x":380,"z":16}'
TARGETS='{"dirt":4}'
MAX_STEPS=20
REPLAN_EVERY=8
CONTROLLER=jev
RUN_ID=demo
HARNESS=http://127.0.0.1:3077

# --- Comando umano via chat (opzionale) ---
# Abilita il telecomando del bot via chat di gioco, in linguaggio naturale.
# Attivo solo se CHAT_ALLOWLIST è valorizzato (gamertag o xuid, separati da virgola):
# solo i mittenti elencati possono ordinare al bot. Usare placeholder, mai gamertag reali
# in un repo pubblico.
# CHAT_ALLOWLIST=<gamertag_o_xuid1>,<gamertag_o_xuid2>
# CHAT_PREFIXES=@bot          # prefissi accettati, separati da virgola (default @bot);
#                             # il bot risponde anche al proprio nome (observe().self), vedi CHAT_SELF_NAME
# CHAT_SELF_NAME=on           # on/off: aggiunge @BEDROCK_USERNAME e il gamertag appreso dal server ai trigger
#                             # utile per accettare sia il generico sia il nome del bot
# CHAT_PREFIX=@bot            # prefisso singolo legacy: si somma a CHAT_PREFIXES
# CHAT_CONTROL=on             # on/off; default on se CHAT_ALLOWLIST è impostato

# Domande in chat (M6): un messaggio con trigger che chiede un fatto sul bot
# ("dove sei?", "che fai?", "hai fame?") riceve una risposta composta dai dati
# di observe() e non produce un goal. Il testo non lo scrive mai il modello.
# M6.1: la guardia looksLikeQuestion (sul testo grezzo) e' un pre-filtro, quindi
# un ordine non paga nessuna chiamata al modello prima dell'ack; una domanda che
# il router non sa decidere riceve un rifiuto ("non ho capito la domanda"),
# viene loggata come chat_unrouted e non crea un goal.
# CHAT_INTENT=on              # on/off; default on se TYPESAFE_API_KEY o OPENROUTER_API_KEY è impostata
# CHAT_INTENT_URL=            # endpoint decisions alternativo (es. un Jev locale); default TypeSafe/OpenRouter
# CHAT_INTENT_MODEL=          # modello per il routing (default JEV_MODEL)
# CHAT_INTENT_TIMEOUT_MS=4000 # oltre questo tempo una domanda riceve il rifiuto (non un goal); un ordine non aspetta nulla
# CHAT_INTENT_MIN_P=0.4       # probabilità minima per accettare l'intento (0 = argmax); 0.4 = prudente

# Lingua della chat (M7.2): le frasi che il bot compone da solo — conferma
# dell'ordine, esito, risposte alle domande, saluto proattivo, rifiuti — escono
# dal catalogo `chat-i18n.mjs` (un messaggio per chiave, per lingua). `CHAT_LANG`
# sceglie la lingua: it (default, comportamento storico del server), en, fr, es,
# de. La lingua non dipende dall'LLM: senza chiave il percorso deterministico
# parla comunque la lingua configurata. Un messaggio chiaro fa sempre testo
# (l'LLM risponde nella lingua di chi scrive); `CHAT_LANG` copre i casi ambigui
# ("ok", "grazie", un comando di due parole). Un valore non supportato non spegne
# nulla: si torna all'italiano con un warning in avvio e un log.
# Anche CHAT_GREET_TEMPLATE e CHAT_SMALLTALK_TEMPLATE, se impostati a mano in
# un'altra lingua, restano validi: vincono sul catalogo.
# CHAT_LANG=it                # it | en | fr | es | de; default it

# Chat naturale (M7): con un LLM il bot riformula ack, esito e risposte nella
# lingua del mittente e in prima persona, con parole sue, invece di ripetere la
# frase composta dal controller. Il modello riformula soltanto: riceve i fatti di
# observe() e il testo deterministico come grounding, non decide mai un'azione e
# non crea goal. Un saluto/ringraziamento riceve una risposta libera e non
# diventa un ordine.
# Senza chiave (o con CHAT_LLM=off) la chat resta comunque in italiano: il
# percorso deterministico compone le frasi da solo (M7.1: i goal strutturati —
# chore del villaggio, bisogni, recupero — hanno un'etichetta italiana in
# human-questions.mjs, e l'objective di un ordine arriva dal planner nella lingua
# di chi ha scritto). La chiave non e' l'interruttore della lingua: e' cio' che
# rende la frase naturale e variabile invece che ripetuta.
# Con la chiave attiva il testo del messaggio e i fatti di observe() partono
# verso il provider: tieni CHAT_ALLOWLIST valorizzata e la chiave fuori da git.
# DEEPSEEK_API_KEY=          # alias legacy di CHAT_LLM_API_KEY (ancora onorato dal codice)
# CHAT_LLM_API_KEY=          # nome canonico della chiave; con CHAT_LLM_URL punta a un altro
#                            # provider OpenAI-compatibile (es. OpenRouter: CHAT_LLM_MODEL=deepseek/deepseek-v3.2)
# CHAT_LLM=on                # on/off; default on quando una chiave e' presente
#                            # (on senza chiave resta spento; off spegne anche con la chiave)
# CHAT_LLM_MODEL=deepseek-flash      # DeepSeek-V4.1-Flash: il nome corto accettato
#                                    # dall'API (i legacy deepseek-v4-flash* sono ritirati e
#                                    # serviti dallo stesso modello); alternative: deepseek-chat,
#                                    # deepseek-reasoner. Con un altro provider metti qui il suo
#                                    # modello. Nota: V4.1-Flash ha il thinking acceso di default
#                                    # (effort high) e in thinking mode la temperature viene
#                                    # ignorata e i token di risposta sono condivisi col
#                                    # ragionamento: con max_tokens 120 la risposta torna vuota
#                                    # (finish_reason length, misurato il 07/10/2026).
# CHAT_LLM_THINKING=off      # l'interruttore del client per un modello che pensa: off (default)
#                            # manda {"thinking":{"type":"disabled"}} nel body, come una battuta
#                            # di chat richiede; low|high|max mandano reasoning_effort e alzano il
#                            # budget (1200, o 2000 per la risposta ragionata); default|auto non
#                            # mandano nulla e lasciano decidere il provider.
# CHAT_LLM_URL=https://api.deepseek.com/chat/completions   # endpoint OpenAI-compatibile
# CHAT_LLM_TIMEOUT_MS=8000   # oltre questo tempo si invia il testo deterministico
# CHAT_PERSONA='Hermes, il bot di casa di un server Minecraft Bedrock: ...'
# CHAT_SMALLTALK_TEMPLATE='@{name} ciao! dimmi pure.'   # fallback senza LLM per un saluto

# Risposta ragionata (M12, richiede il motore M7): se la domanda contiene una
# parola di deliberazione ("ragiona", "pensa", "think", "piensa", ...) il
# marcatore viene tolto prima del dedup e del router e la risposta la compone il
# motore dai fatti (ultime azioni, ultimo errore, vene vicine) invece di leggerla
# dal catalogo. Cambia la RISPOSTA, mai l'azione: nessun goal, nessuna scrittura,
# e se il modello non risponde o il cooldown e' attivo si ricade sul catalogo.
# CHAT_REASON=on                  # default: segue lo stato di M7 (senza chiave e' spento)
# CHAT_REASON_COOLDOWN_MS=5000    # per mittente; dentro la finestra risponde il catalogo
# CHAT_REASON_MARKERS=            # sostituisce la lista incorporata (ragiona,pensa,think,...)
#                                 # il saluto di benvenuto insegna la prima parola (o quella della lingua)

# Avviso risorse (M11): il bot annuncia in chat quando il censimento trova una
# vena preziosa — una frase per vena, una volta per posizione, mai due volte. Il
# testo esce dal catalogo (CHAT_LANG) e lo inietta l'harness nell'adapter, quindi
# nessuna coordinata passa da un modello. Il nome viene ripiegato al nucleo:
# diamond copre diamond_ore e deepslate_diamond_ore.
# ORE_ALERT=diamond            # lista separata da virgole; off/none/'' = silenzio
# ORE_ALERT_RANGE=32           # annuncia solo le vene entro questa distanza
# ORE_ALERT_COOLDOWN_MS=5000   # silenzio minimo fra due avvisi

# Annuncio in autonomia (M8): quando parte un goal che nessuno ha chiesto
# (chore del villaggio, bisogno del governor) il bot dice cosa sta per fare —
# "In autonomia: sto raccogliendo le patate" — invece di sparire nel silenzio.
# Una volta per goal, con cooldown, e solo se un umano e' entro CHAT_GREET_RANGE:
# e' informazione, non un diario. La frase esce dal catalogo (CHAT_LANG) e passa
# da saySmart, quindi l'LLM puo' riformularla ma non inventa fatti.
# CHAT_NARRATE=on                    # default: segue CHAT_REPLY (canale chat aperto)
# CHAT_NARRATE_COOLDOWN_MS=300000    # silenzio minimo fra due annunci (0 = nessun limite)

# Saluto proattivo: percepito un umano fidato vicino, il bot si presenta e
# spiega la sintassi per dargli un ordine. Richiede CHAT_ALLOWLIST (canale
# ordini aperto) e che il bot sia spawnato; usa POST /say dell'harness.
# CHAT_GREET=on               # default on se CHAT_CONTROL != off e allowlist presente
# CHAT_GREET_RANGE=24         # raggio (blocchi) entro cui l'umano è "percepito"
# CHAT_GREET_COOLDOWN_MS=600000  # non risalutare lo stesso umano prima (0 = una volta per sessione)
# CHAT_GREET_TEMPLATE='Ciao {name}! Sono Hermes... {prefix} <ordine>...'  # {name} e {prefix} ({prefixes} = tutti i trigger)

# --- Survival Intelligence Layer (opzionali) ---
# Milestone finale gestito dal Progression Engine: il controller sceglie da solo
# i prerequisiti mancanti (knowledge/progression.json) e verifica lo stato reale
# (runs/<run>/skills.jsonl). Esempi: first_night, enter_nether.
# Con CURRICULUM impostato, WAYPOINT e TARGETS possono restare vuoti.
# CURRICULUM=first_night

# Obiettivo suggerito in /survival (solo diagnostica del harness, opzionale).
# PROGRESSION_GOAL=enter_nether

# --- Goal Contract (opzionale, Slice A) ---
# Trasforma il goal in un contratto strutturato; il controller ne deriva lo stato
# RUNNING | SUCCESS | FAILED | BLOCKED e si ferma su SUCCESS/FAILED/BLOCKED.
# Senza queste variabili il comportamento resta quello precedente (nessun contratto).
# GOAL_CONTRACT='{"goal":"obtain_diamonds","target":{"item":"diamond","count":20},"constraints":{"maxDeaths":2,"preserveItems":["diamond_pickaxe"]},"success":{"inventoryTagGte":{"diamonds":20}},"failure":{"deathsAtLeast":3}}'
# MAX_DEATHS=2                 # scorciatoia per constraints.maxDeaths (fallisce se si supera)
# PRESERVE_ITEMS=diamond_pickaxe,netherite_ingot   # item che non devono essere persi

# --- Sessione persistente (AI-player roadmap M0 -> M1, opzionale) ---
# Con SESSION=on il controller non esce a fine goal: resta in IDLE e accetta
# nuovi goal (ordini in chat, autonomia) senza riconnettersi. Senza SESSION il
# comportamento e' quello storico one-shot e lo stato IDLE non esiste, quindi
# autonomia e lavoro di villaggio non partono mai.
# SESSION=on                   # default off (one-shot)
# IDLE_POLL_MS=2000            # ogni quanto l'IDLE ricontrolla la coda
# IDLE_TIMEOUT_MS=0            # 0 = resta in IDLE senza scadenza
# RESUME=on                    # default: come SESSION; rimette in coda i goal sospesi del run precedente

# --- Autonomia (AI-player roadmap M3, opzionale) ---
# In IDLE il bot genera da se' goal dai bisogni di sopravvivenza (deterministico:
# decide il governor, non un LLM). Richiede SESSION=on.
# AUTONOMY=on                  # default off
# AUTONOMY_COOLDOWN_MS=120000  # anti-loop per bisogno
# AUTONOMY_MAX_GOALS=25        # tetto di goal autonomi per sessione
# SURVIVAL_IDLE_COOLDOWN_MS=30000  # cooldown dei bisogni urgenti (piu' corto: la notte non aspetta)

# --- Lavoro di villaggio (AI-player roadmap M3b, opzionale) ---
# In IDLE, oltre ai bisogni di sopravvivenza, il bot cerca una "chore" utile al
# villaggio (coltivazioni, pastorizia, legname, minerali, pesca) e la esegue come
# goal autonomo. Una chore nasce solo se il harness sta gia' offrendo l'intento
# corrispondente in GET /options, e si chiude su un delta di stato misurato
# (oggetti guadagnati, un seme speso, un cucciolo nato): il modello non decide
# mai se il lavoro e' finito. Priorita' autonoma: un ordine in chat o
# un'emergenza vincono sempre. Richiede SESSION=on.
# VILLAGE_WORK=on              # on/off; default: lo stesso valore di AUTONOMY
# VILLAGE_COOLDOWN_MS=120000   # non riproporre la stessa chore prima di (anti-loop)
# VILLAGE_MAX_CHORES=12        # massimo di chore per sessione
# VILLAGE_STORE_THRESHOLD=8    # stack pieno da cui vale la pena depositare in cassa
#
# M3c: chi ha raccolto adesso riporta. A fine di un goal di villaggio riuscito il
# controller accoda un ultimo goal "riponi quello che hai in zaino" (la stessa
# chore store_harvest, soglia 1 invece di 8), cosi' il ciclo e'
# produce -> riponi -> verifica e non una collezione di chore indipendenti. Cosa
# e' depositabile lo decide il harness (osserva `deposit` in GET /observe):
# strumenti, armatura, secchi, semi, torce/stazioni e una riserva di cibo
# restano in zaino, e il baule preferito e' quello che contiene gia' lo stesso
# oggetto (poi il piu' vicino). Si chiude quando la roba e' davvero uscita,
# mai su una dichiarazione del modello.
# VILLAGE_STORE_EPILOGUE=on    # on/off; default: lo stesso valore di VILLAGE_WORK
